@model Fornecedor;

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Fornecedor";
}

<form action="/Fornecedor/Excluir/@Model.Id" method="post">

    <p>Você Deseja Excluir o Fornecedor "@Model.Nome"? Esta Ação É Irreversível.</p>

    <button type="submit">Confirmar Exclusão</button>
</form>

<p>
    <a href="/Fornecedor/Listar">Voltar Para a Lista</a>
</p>
