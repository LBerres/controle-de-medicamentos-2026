@using ControleDeMedicamentos.WebApp.ModuloFornecedores

@model List<Fornecedor>

<h2> Controle de Fornecedores </h2>

<hr />
<a href="/">Início</a> / @* Âncora ou Link *@
<a href="/Fornecedor/Listar">Fornecedores</a> / @* Âncora ou Link *@
<a href="/Medicamento/Listar">Medicamentos</a> / @* Âncora ou Link *@
<hr />

<h1>Cadastrar Fornecedor</h1>

<form action="/Fornecedor/Cadastrar" method="post">

    <div>
        <label for="nome">Nome</label>
        <input id="nome" name="nome" type="text">
    </div>

    <div>
        <label for="telefone">Telefone</label>
        <input id="telefone" name="telefone" type="text">
    </div>

    <div>
        <label for="cnpj">CNPJ</label>
        <input id="cnpj" name="cnpj" type="text">
    </div>

    <button type="submit">Cadastrar</button>
</form>

<p>
    <a href="/Fornecedor/Listar">Voltar Para a Lista</a>
</p>
